server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    location = /gis/trenches {
        limit_except GET { deny all; }
        resolver 127.0.0.11 valid=30s;
        set $gis_host gis-api.494956.xyz;
        proxy_ssl_server_name on;
        proxy_ssl_name gis-api.494956.xyz;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_set_header Host gis-api.494956.xyz;
        proxy_set_header Authorization "Bearer ${GIS_API_TOKEN}";
        proxy_set_header Cookie "";
        proxy_read_timeout 20s;
        proxy_pass https://$gis_host/layers/elektrizitaet_trasse/features$is_args$args;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
